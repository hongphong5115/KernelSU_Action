# ==============================================================================
# CẤU HÌNH BIÊN DỊCH KERNEL CHO REALME GT NEO 2 (BITRA - SM8250 - A13)
# ==============================================================================

# 1. NGUỒN MÃ KERNEL REALME UI 4.0 (ANDROID 13 - LINUX KERNEL 4.19)
KERNEL_SOURCE=https://github.com/realme-kernel-opensource/realme_GTneo2-Q5pro-GTMasterExploratory-AndroidT-kernel-source
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 2. CẤU HÌNH TOOLCHAIN (PROTON-CLANG TỐI ƯU QUALCOMM 4.19)
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang
CUSTOM_CLANG_BRANCH=master

# 3. CỜ BIÊN DỊCH CHÉO (CROSS COMPILE - BẮT BUỘC CHO QUALCOMM 4.19)
EXTRA_CMDS="CLANG_TRIPLE=aarch64-linux-gnu- CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-"
DISABLE_CC_WERROR=true
DISABLE_LTO=true

# 4. CẤU HÌNH KERNEL ROOT
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
ENABLE_SUSFS=false

# 5. ĐÓNG GÓI FLASHABLE ANYKERNEL3 ZIP
ANYKERNEL3=true
