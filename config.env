# ==============================================================================
# CẤU HÌNH BIÊN DỊCH KERNEL SUSFS CHO REALME GT NEO 2 (BITRA - SM8250 - A13)
# ==============================================================================

# 1. NGUỒN MÃ KERNEL REALME UI 4.0 (ANDROID 13 - LINUX KERNEL 4.19)
KERNEL_SOURCE=https://github.com/realme-kernel-opensource/realme_GTneo2-Q5pro-GTMasterExploratory-AndroidT-kernel-source
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 2. CẤU HÌNH TOOLCHAIN (PROTON-CLANG TỐI ƯU QUALCOMM 4.19)
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang
CUSTOM_CLANG_BRANCH=master

# 3. CẤU HÌNH KERNEL ROOT & SUSFS (VIẾT THƯỜNG TOÀN BỘ)
# Khuyên dùng sukisu-ultra nhánh builtin vì đã tích hợp sẵn SusFS, không lo đụng độ patch trên 4.19
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

# Kích hoạt SusFS
ENABLE_SUSFS=false
SUSFS_BRANCH=kernel-4.19

# 4. ĐÓNG GÓI FLASHABLE ANYKERNEL3 ZIP
ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3
ANYKERNEL3_BRANCH=master
